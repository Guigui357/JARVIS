# Copie este arquivo para "jarvis.env" (ele é ignorado pelo git) e preencha.
# Também é lido de ~/.jarvis/config.env. Variáveis de ambiente têm prioridade.

GEMINI_API_KEY=cole_sua_chave_aqui
# Se o modelo padrão (gemini-1.5-pro) tiver sido descontinuado, o J.A.R.V.I.S. tenta
# escolher outro automaticamente; fixe aqui um modelo da sua conta para evitar a busca.
# GEMINI_MODEL=

HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=cole_seu_token_de_longa_duracao_aqui

# 1 = ligar a voz (requer pyttsx3)
JARVIS_VOZ=0
# 1 = pedir autorização por diálogo antes de ações sensíveis (recomendado)
JARVIS_CONFIRMAR=1

# Controle de tela
# Modelo de visão só para o controle de tela (vazio = o mesmo do chat)
# GEMINI_MODEL_TELA=
# 1 = pedir autorização a cada ação (mais seguro, mais lento)
JARVIS_TELA_CONFIRMAR_PASSOS=0
# 1 = minimizar a janela do JARVIS durante a tarefa
JARVIS_TELA_MINIMIZAR=1
